# Meridian DDNS Configuration Overrides
# Copy to .env and adjust as needed

# Path to config file (default: /etc/meridian/config.yaml)
# MERIDIAN_CONFIG=/etc/meridian/config.yaml

# Override poll interval in seconds (default: 300)
# MERIDIAN_POLL_INTERVAL=300

# Override log level (default: INFO)
# MERIDIAN_LOG_LEVEL=INFO

# Override state file path (default: /var/lib/meridian/state.json)
# MERIDIAN_STATE_FILE=/var/lib/meridian/state.json
